<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#9D52BF"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity3">

    <ImageButton
        android:id="@+id/BackButtonP3"
        android:layout_width="134dp"
        android:layout_height="104dp"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="16dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/schermafbeelding_2026_10_07_141405" />

    <ImageButton
        android:id="@+id/NextButtonP3"
        android:layout_width="134dp"
        android:layout_height="104dp"
        android:layout_marginBottom="16dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.942"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/schermafbeelding_2026_10_20_113520" />

    <View
        android:id="@+id/yelowboxp3"
        android:layout_width="290dp"
        android:layout_height="264dp"
        android:layout_marginTop="92dp"
        android:background="#DFDF00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/whiteboxp3"
        android:layout_width="243dp"
        android:layout_height="207dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/yelowboxp3"
        app:layout_constraintEnd_toEndOf="@+id/yelowboxp3"
        app:layout_constraintHorizontal_bias="0.51"
        app:layout_constraintStart_toStartOf="@+id/yelowboxp3"
        app:layout_constraintTop_toTopOf="@+id/yelowboxp3" />

    <TextView
        android:id="@+id/Infop3"
        android:layout_width="110dp"
        android:layout_height="180dp"
        android:text="Your name: Your  Time:  Your Email:"
        android:textColor="#000000"
        android:textSize="21dp"
        app:layout_constraintBottom_toBottomOf="@+id/whiteboxp3"
        app:layout_constraintEnd_toEndOf="@+id/whiteboxp3"
        app:layout_constraintHorizontal_bias="0.124"
        app:layout_constraintStart_toStartOf="@+id/whiteboxp3"
        app:layout_constraintTop_toTopOf="@+id/whiteboxp3"
        app:layout_constraintVertical_bias="0.379" />

    <TextView
        android:id="@+id/Incorectp3"
        android:layout_width="239dp"
        android:layout_height="92dp"
        android:textSize="17dp"
        android:text="If any of this information is incorrect please press back. If the information is correct press next."
        app:layout_constraintBottom_toBottomOf="@+id/whiteboxp3"
        app:layout_constraintEnd_toEndOf="@+id/whiteboxp3"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/whiteboxp3"
        app:layout_constraintTop_toTopOf="@+id/whiteboxp3"
        app:layout_constraintVertical_bias="0.93" />

    <TextView
        android:id="@+id/NameInBoxp3"
        android:layout_width="111dp"
        android:layout_height="26dp"
        android:textSize="14dp"
        android:text="Name"
        tools:layout_editor_absoluteX="211dp"
        tools:layout_editor_absoluteY="136dp" />

    <TextView
        android:id="@+id/TimeInBoxp3"
        android:layout_width="111dp"
        android:layout_height="26dp"
        android:text="Time"
        android:textSize="14dp"
        tools:layout_editor_absoluteX="211dp"
        tools:layout_editor_absoluteY="162dp" />

    <TextView
        android:id="@+id/EmailInBoxp3"
        android:layout_width="111dp"
        android:layout_height="26dp"
        android:text="Email"
        android:textSize="14dp"
        tools:layout_editor_absoluteX="211dp"
        tools:layout_editor_absoluteY="188dp" />

</androidx.constraintlayout.widget.ConstraintLayout>